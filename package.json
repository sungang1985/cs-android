{
  "name": "cs-android",
  "version": "0.1.0",
  "private": true,
  "description": "CS-style first-person shooter for Android phones (TypeScript + Three.js, WebView/PWA)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch --serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "build:android": "node tools/build.mjs && node tools/sync-android.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5"
  }
}
